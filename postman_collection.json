{
  "info": {
    "name": "Books API (auth)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "access",
      "value": ""
    },
    {
      "key": "refresh",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/register/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"artem\",\n  \"first_name\": \"Artem\",\n  \"last_name\": \"\",\n  \"email\": \"artem@example.com\",\n  \"password\": \"StrongPass123!\",\n  \"password_confirm\": \"StrongPass123!\"\n}"
            }
          }
        },
        {
          "name": "Register (invalid → 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/register/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"\",\n  \"email\": \"bad-email\",\n  \"password\": \"123\",\n  \"password_confirm\": \"456\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"artem\",\n  \"password\": \"StrongPass123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.access) pm.collectionVariables.set('access', d.access);",
                  "if (d.refresh) pm.collectionVariables.set('refresh', d.refresh);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (wrong password → 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"artem\",\n  \"password\": \"wrong\"\n}"
            }
          }
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/refresh/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "refresh",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.access) pm.collectionVariables.set('access', d.access);",
                  "if (d.refresh) pm.collectionVariables.set('refresh', d.refresh);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/me/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "me",
                ""
              ]
            }
          }
        },
        {
          "name": "Me (no token → 401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/me/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "me",
                ""
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "List books (public)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/books/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books",
                ""
              ]
            }
          }
        },
        {
          "name": "Get book (public)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/books/1/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books",
                "1",
                ""
              ]
            }
          }
        },
        {
          "name": "Create book (auth)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/books/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"1984\",\n  \"author\": \"George Orwell\",\n  \"year\": 1949\n}"
            }
          }
        },
        {
          "name": "Create book (no token → 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/books/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"1984\",\n  \"author\": \"George Orwell\",\n  \"year\": 1949\n}"
            }
          }
        },
        {
          "name": "Update book (auth)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/books/1/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books",
                "1",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"1984\",\n  \"author\": \"George Orwell\",\n  \"year\": 1950\n}"
            }
          }
        },
        {
          "name": "Patch book (auth)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/books/1/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books",
                "1",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"year\": 1949\n}"
            }
          }
        },
        {
          "name": "Delete book (admin only, else 403)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/books/1/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books",
                "1",
                ""
              ]
            }
          }
        }
      ]
    }
  ]
}